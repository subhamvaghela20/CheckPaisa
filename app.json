{
  "expo": {
    "name": "CheckPaisa",
    "slug": "checkpaisa",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#10B981"
    },
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.sidgjh.checkpaisa",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#10B981"
      }
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      ["expo-speech-recognition", {
        "microphonePermission": "Allow CheckPaisa to use the microphone for voice transactions.",
        "speechRecognitionPermission": "Allow CheckPaisa to recognize your speech."
      }]
    ],
    "extra": {
      "eas": {
        "projectId": "35d30b67-2c53-4e37-8b30-bd1fb34b844d"
      }
    },
    "owner": "siddharajqa07s-team"
  }
}
